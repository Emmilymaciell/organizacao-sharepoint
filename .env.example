# Modelo do .env - SO NOMES E PLACEHOLDERS. Copie para .env (ignorado pelo Git) e preencha.
# App registrado no Entra ID com permissao Sites.Selected (client credentials).
GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
GRAPH_CLIENT_SECRET=defina-no-env-local
GRAPH_OBJECT_ID=00000000-0000-0000-0000-000000000000
GRAPH_SECRET_ID=00000000-0000-0000-0000-000000000000
SHAREPOINT_HOST=contoso.sharepoint.com
SHAREPOINT_SITE=/sites/exemplo
PROG_CONTA_DESTINO=pessoa@example.com
